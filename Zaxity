local SAVE_FILE = "inchworm_saves.json"
local hasIO = (typeof(writefile) == "function") and (typeof(readfile) == "function")
local Slots = { nil, nil, nil, nil, nil }
local function deepCopy(v, seen)
	seen = seen or {}
	if type(v) ~= "table" then return v end
	if seen[v] then return seen[v] end
	local out = {}
	seen[v] = out
	for k, val in pairs(v) do out[deepCopy(k, seen)] = deepCopy(val, seen) end
	return out
end
local function serialize()
	return { esp = deepCopy(EO), cat = deepCopy(CS), status = deepCopy(SRV), auto = deepCopy(AS), mg = deepCopy(MS) }
end
local function applySave(d)
	if not d then return end
	if d.esp then for k, v in pairs(d.esp) do EO[k] = v end end
	if d.cat then for cn, tbl in pairs(d.cat) do if CS[cn] then for k, v in pairs(tbl) do CS[cn][k] = v end end end end
	if d.status then for k, v in pairs(d.status) do SRV[k] = v end end
	if d.auto then AS.detect = d.auto.detect or AS.detect AS.teleport = d.auto.teleport or AS.teleport end
	if d.mg then MS.pct = d.mg.pct or MS.pct end
	aAV()
end
local function saveDisk()
	if not hasIO then return end
	pcall(function()
		local out = {}
		for i = 1, 5 do if Slots[i] then out[tostring(i)] = { name = Slots[i].name, data = Slots[i].data } end end
		writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(out))
	end)
end
local function loadDisk()
	if not hasIO then return end
	pcall(function()
		if isfile(SAVE_FILE) then
			local dec = game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
			for i = 1, 5 do if dec[tostring(i)] then Slots[i] = { name = dec[tostring(i)].name, data = dec[tostring(i)].data } end end
		end
	end)
end
loadDisk()
local savePanel, sScroll2
savePanel, sScroll2 = mkSub("SavePanel", "SAVE SLOTS", 290)
local function refreshSave()
	for _, c in ipairs(sScroll2:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	for i = 1, 5 do
		local sl = Slots[i]
		local row = Instance.new("Frame", sScroll2)
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 44)
		row.LayoutOrder = i
		row.ZIndex = 33
		mL(row, i .. ". " .. (sl and sl.name or "Empty"), 2, 0, 170, 18, 11)
		local lb = mB(row, "Load", 0, 20, 55, 20, Color3.fromRGB(60, 120, 180), 11)
		local sb = mB(row, sl and "Resave" or "Save", 58, 20, 62, 20, Color3.fromRGB(60, 160, 90), 11)
		local rb = mB(row, "Rename", 124, 20, 62, 20, Color3.fromRGB(140, 100, 60), 11)
		bS(lb, function()
			if Slots[i] then
				applySave(deepCopy(Slots[i].data))
				Notify("Loaded slot " .. i, Color3.fromRGB(60, 140, 200))
			end
		end)
		bS(sb, function()
			local nm = (Slots[i] and Slots[i].name) or ("Slot " .. i)
			Slots[i] = { name = nm, data = serialize() }
			saveDisk()
			refreshSave()
			Notify("Saved slot " .. i, Color3.fromRGB(60, 180, 90))
		end)
		bS(rb, function()
			local tb = Instance.new("TextBox", savePanel)
			tb.Size = UDim2.fromOffset(180, 28)
			tb.Position = UDim2.new(0.5, -90, 0.5, -14)
			tb.BackgroundColor3 = Color3.fromRGB(40, 45, 60)
			tb.BorderSizePixel = 0
			tb.Text = (Slots[i] and Slots[i].name) or ("Slot " .. i)
			tb.TextColor3 = Color3.new(1, 1, 1)
			tb.Font = Enum.Font.GothamBold
			tb.TextSize = 14
			tb.ClearTextOnFocus = false
			tb.ZIndex = 200
			local c = Instance.new("UICorner", tb)
			c.CornerRadius = UDim.new(0, 6)
			tb:CaptureFocus()
			task.delay(0.1, function() tb:ReleaseFocus() end)
			task.spawn(function()
				task.wait(6)
				if tb.Parent then
					if not Slots[i] then
						Slots[i] = { name = tb.Text, data = serialize() }
					else
						Slots[i].name = tb.Text
						Slots[i].data = serialize()
					end
					saveDisk()
					refreshSave()
					tb:Destroy()
					Notify("Renamed slot " .. i, Color3.fromRGB(140, 100, 60))
				end
			end)
		end)
	end
end
