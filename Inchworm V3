local function radarBuildCatRows(key)
	radarBuildCatPanel()
	local s = radar.catScroll
	if not s then return end
	for _, c in ipairs(s:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local cfg = radarCfg[key]
	if not cfg then return end
	local titles = { player = "PLAYER", worm = "INCHWORM", spawner = "INCHWORM SPAWN", generator = "GENERATOR" }
	radar.catTitle.Text = titles[key] or "?"
	local o = 0
	local function nxt() o = o + 1; return o end
	if key == "player" then
		radarCycle(s, "Show Name", { "Off", "Player", "DisplayName" }, function() return cfg.nameMode end, function(v) cfg.nameMode = v end, nxt())
		radarToggle(s, "Show Health", function() return cfg.health end, function(v) cfg.health = v end, nxt())
		radarToggle(s, "Show Dead Player", function() return cfg.dead end, function(v) cfg.dead = v end, nxt())
		radarToggle(s, "Show Snatched", function() return cfg.snatch end, function(v) cfg.snatch = v end, nxt())
	elseif key == "worm" then
		radarCycle(s, "Show Name", { "Off", "Inchworm" }, function() return cfg.nameMode end, function(v) cfg.nameMode = v end, nxt())
		radarToggle(s, "Show Snatched", function() return cfg.snatch end, function(v) cfg.snatch = v end, nxt())
	elseif key == "spawner" then
		radarCycle(s, "Show Name", { "Off", "Inchworm Spawn" }, function() return cfg.nameMode end, function(v) cfg.nameMode = v end, nxt())
	elseif key == "generator" then
		radarCycle(s, "Show Name", { "Off", "Generator" }, function() return cfg.nameMode end, function(v) cfg.nameMode = v end, nxt())
	end
end

