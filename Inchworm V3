local function fmtLiveTime(sec)
	local s = math.max(0, math.floor(sec or 0))
	return string.format("%d:%02d", math.floor(s/60), s%60)
end
local function realClockStr()
	local ok, s = pcall(function()
		local d = DateTime.now():ToLocalTime()
		local h = d.Hour
		local ampm = (h >= 12) and "PM" or "AM"
		local h12 = h % 12; if h12 == 0 then h12 = 12 end
		return string.format("%d:%02d %s", h12, d.Minute, ampm)
	end)
	if ok and s then return s end
	return "??:??"
end
