local function scaleBB(bb, d)
	local s = dscale(d)
	local bw = bb:GetAttribute("BW") or 100
	local bh = bb:GetAttribute("BH") or 60
	bb.Size = UDim2.fromOffset(bw*s, bh*s)
	for _, x in ipairs(bb:GetDescendants()) do
		if x:IsA("TextLabel") then
			local b = x:GetAttribute("BS")
			if b then x.TextSize = math.max(6, math.floor(b*s)) end
		end
	end
end
