local function updateRadar()
	local sg = radar.sg
	if not sg then return end
	if not radarCfg.panelOn then sg.Enabled = false; return end
	sg.Enabled = true
	local body = radar.body
	if not body then return end

	local sz = radarCfg.panelSize * 20
	local headerH = 22
	local pad = 6
	local total = sz + pad * 2 + headerH
	radar.panel.Size = UDim2.fromOffset(total, total)
	body.Size = UDim2.fromOffset(sz, sz)
	body.Position = UDim2.new(0.5, -sz/2, 0, headerH + pad)

	local blipSize = math.max(6, math.floor(radarCfg.panelSize * 1.0))
	local textPx   = math.max(6, math.floor(radarCfg.panelSize * 0.8))

	local cam = workspace.CurrentCamera
	local camYaw = 0
	if cam then
		local look = cam.CFrame.LookVector
		camYaw = math.atan2(look.X, look.Z)
	end

	local function resizeRing(r, lbl, pct)
		if not r then return end
		local d = sz * pct
		r.Size = UDim2.fromOffset(d, d)
		if lbl then lbl.Size = UDim2.fromOffset(d * 0.8, 14) end
	end
	resizeRing(radar.dangRing, radar.dangLbl, 0.33)
	resizeRing(radar.medRing,  radar.medLbl,  0.66)
	resizeRing(radar.safeRing, radar.safeLbl, 1.00)

	local zoneVis = radarCfg.showZones
	if radar.safeRing then radar.safeRing.Visible = zoneVis end
	if radar.medRing  then radar.medRing.Visible  = zoneVis end
	if radar.dangRing then radar.dangRing.Visible = zoneVis end

	for _, c in ipairs(body:GetChildren()) do
		if c:GetAttribute("Blip") then c:Destroy() end
	end

	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position
	local range = radarCfg.range or 250
	local half = sz / 2

	local function place(blip, worldPos)
		local off = worldPos - myPos
		local d = math.sqrt(off.X*off.X + off.Z*off.Z)
		if d > range then return false end
		local norm = math.min(d / range, 0.98)
		local worldAng = math.atan2(off.X, off.Z)
		local relAng = worldAng - camYaw
		local px = half - math.sin(relAng) * norm * half * 0.94
		local py = half - math.cos(relAng) * norm * half * 0.94
		blip.Position = UDim2.fromOffset(px, py)
		return true
	end

	if radarCfg.worm.show then
		local nw = tick()
		for m, t in pairs(tracked) do
			if m.Parent then
				local rt = getRoot(m)
				if rt then
					local held = nw < (t.grabbedUntil or 0)
					local col = held and Color3.fromRGB(255, 0, 180) or Color3.fromRGB(255, 220, 40)
					local txt = ""
					if radarCfg.worm.nameMode ~= "Off" then txt = radarCfg.worm.nameMode end
					if held and radarCfg.worm.snatch then
						txt = (txt ~= "" and (txt .. " ") or "") .. "[GRAB]"
					end
					local b = radarMakeBlip(col, txt, blipSize + 2, textPx)
					b:SetAttribute("Blip", true)
					if place(b, rt.Position) then b.Parent = body else b:Destroy() end
				end
			end
		end
	end

	if radarCfg.player.show then
		for c, t in pairs(playerESP) do
			if c.Parent and t.player then
				local rt = c:FindFirstChild("HumanoidRootPart")
				if rt then
					local held = tick() < (t.grabbedUntil or 0)
					local h = c:FindFirstChildOfClass("Humanoid")
					local hp, mh = readHP(c, h)
					local isDead = false
					if roundInfo.phase ~= "round" then
						isDead = true
					elseif hp and hp <= 0 then
						isDead = true
					end
					if isDead and not radarCfg.player.dead then
					else
						local col
						if isDead then col = Color3.fromRGB(140, 140, 140)
						elseif held and radarCfg.player.snatch then col = Color3.fromRGB(40, 120, 255)
						else col = Color3.fromRGB(40, 220, 60) end
						local nm = ""
						if radarCfg.player.nameMode == "Player" then nm = "Player"
						elseif radarCfg.player.nameMode == "DisplayName" then nm = t.player.DisplayName end
						local txt = nm
						if radarCfg.player.health and hp and mh then
							local pct = math.floor((hp / math.max(mh, 1)) * 100 + 0.5)
							txt = (txt ~= "" and (txt .. " ") or "") .. pct .. "%"
						end
						local b = radarMakeBlip(col, txt, blipSize, textPx)
						b:SetAttribute("Blip", true)
						if place(b, rt.Position) then b.Parent = body else b:Destroy() end
					end
				end
			end
		end
	end

	if radarCfg.spawner.show then
		for inst in pairs(spawnerESP) do
			if inst.Parent then
				local rt = getRoot(inst)
				if rt then
					local txt = radarCfg.spawner.nameMode ~= "Off" and radarCfg.spawner.nameMode or ""
					local b = radarMakeBlip(Color3.fromRGB(200, 100, 255), txt, blipSize, textPx)
					b:SetAttribute("Blip", true)
					if place(b, rt.Position) then b.Parent = body else b:Destroy() end
				end
			end
		end
	end

	if radarCfg.generator.show then
		for inst, t in pairs(genESP) do
			if inst.Parent then
				local pos = inst:IsA("BasePart") and inst.Position or (getRoot(inst) and getRoot(inst).Position) or Vector3.zero
				local isR = false
				for _, ch2 in ipairs(inst:GetDescendants()) do
					if ch2:IsA("ProximityPrompt") then
						local a = (ch2.ActionText or ""):lower()
						if a:find(CFG.GeneratorPromptKeyword, 1, true) and ch2.Enabled then isR = true; break end
					end
				end
				local col = isR and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 140, 30)
				local txt = radarCfg.generator.nameMode ~= "Off" and radarCfg.generator.nameMode or ""
				local b = radarMakeBlip(col, txt, blipSize, textPx)
				b:SetAttribute("Blip", true)
				if place(b, pos) then b.Parent = body else b:Destroy() end
			end
		end
	end
end

