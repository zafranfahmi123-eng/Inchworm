local function newTxt(p, sz, fnt, col, y, h)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1; t.Size = UDim2.new(1,0,h,0); t.Position = UDim2.new(0,0,y,0)
	t.Font = fnt; t.TextSize = sz; t.TextColor3 = col; t.TextStrokeTransparency = 0.2
	t:SetAttribute("BS", sz); t.Parent = p
