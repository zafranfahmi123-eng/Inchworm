local hideState = { lastTp = 0, originPos = nil, lastPhase = "idle", didInterTp = false, didActiveTp = false }

local function hideStep()
	if not autoSettings.hideInIntermission then return end
	if shouldPauseAuto() then return end
	local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local now = tick()
	local phase = roundInfo.phase
	local worms = roundInfo.wormsSpawned
	local sec = roundInfo.secondsLeft
	local hasMap = workspace:FindFirstChild("ActiveMap") ~= nil
	if hideState.lastPhase == "intermission" and phase == "round" then
		hideState.originPos = nil
	end
	if phase == "round" and hasMap and worms and not hideState.originPos then
	hideState.originPos = hrp.Position
end
	if phase == "round" and sec <= 3 and sec > 0 then
	if hideState.lastPhase ~= "returning" then
		if hideState.originPos then tp(hideState.originPos) end
		hideState.lastPhase = "returning"
		farmState.paused = true
		farmState.pauseUntil = nil
		autoPlay.steps = autoPlay.steps + 1
	end
	return
end
	if phase == "intermission" then
	if hideState.lastPhase ~= "intermission" then
		hideState.didInterTp = false
		if farmState.paused and not farmState.pauseUntil then
			farmState.paused = false
		end
	end
	hideState.lastPhase = "intermission"
	if sec <= 3 then
		hideState.didInterTp = true
		farmState.paused = true
		farmState.pauseUntil = tick() + 3
		return
	end
		local p = autoSettings.maps["Intermission"]
		if p and not (p.x == 0 and p.y == 0 and p.z == 0) then
			local mode = tostring(autoSettings.hideInterval or "3.8")
			if mode == "None" or mode == "none" or mode == "" then
				if not hideState.didInterTp then
					tp(Vector3.new(p.x, p.y, p.z))
					hideState.didInterTp = true
					hideState.lastTp = now
					autoPlay.steps = autoPlay.steps + 1
					autoPlay.active = true
				end
			else
				local interval = tonumber(mode) or 3.8
				if interval < 0.3 then interval = 0.3 end
				if now - hideState.lastTp >= interval then
					local target = Vector3.new(p.x, p.y, p.z)
					if (hrp.Position - target).Magnitude > 5 then
						tp(target)
						autoPlay.steps = autoPlay.steps + 1
						autoPlay.active = true
					end
					hideState.lastTp = now
				end
			end
		end
		return
	end
	if phase == "round" and worms then
		hideState.lastPhase = "active"
		return
	end
	if phase == "round" and not worms then
		hideState.lastPhase = "waiting"
		return
	end
end

