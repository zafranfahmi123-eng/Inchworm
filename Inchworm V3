local function parseSeconds(txt)
	if not txt then return 999 end
	local m, s = txt:match("(%d+):(%d+)")
	if m and s then return tonumber(m)*60 + tonumber(s) end
	local n = txt:match("(%d+)")
	if n then return tonumber(n) end
	return 999
end
local function detectRoundInfo()
	local pg = lp:FindFirstChild("PlayerGui")
	local g = pg and pg:FindFirstChild("GameUI")
	local tl = g and g:FindFirstChild("TitleLabel")
	local txt = tl and tl.Text or ""
	local plain = txt:gsub("<[^>]->","")
	roundInfo.map = currentMapName()
	roundInfo.wormsSpawned = wormsSpawned()
	if plain:find("Intermission",1,true) then
		roundInfo.phase = "intermission"; roundInfo.secondsLeft = parseSeconds(plain)
	elseif plain:find("ROUND IN PROGRESS",1,true) then
		roundInfo.phase = "round"; roundInfo.secondsLeft = parseSeconds(plain)
	else
		roundInfo.phase = "unknown"; roundInfo.secondsLeft = 999
	end
	roundPhase = roundInfo.phase
end
