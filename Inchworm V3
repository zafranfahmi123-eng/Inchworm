	if wf then
		for _, c in ipairs(wf:GetChildren()) do
			if (c.Name or ""):lower():find("wormspawn",1,true) then spawnPresent = true; break end
		end
	end
	if mapLoaded and not farmState.lastMapLoaded then
	farmState.didLobbyTp = false; farmState.didStartTp = false
	farmState.didHomeTp = false; farmState.didInterTp = false
	farmState.lastWormsSpawned = false
	farmState.nextAction = nil; farmState.nextAt = 0
	farmState.didTpAt145 = false
end
if not mapLoaded then
	farmState.didLobbyTp = false; farmState.didStartTp = false
	farmState.didHomeTp = false; farmState.didInterTp = false
	farmState.lastWormsSpawned = false
	farmState.nextAction = nil; farmState.nextAt = 0
	farmState.didTpAt145 = false
end
	local mapPos = autoSettings.maps[roundInfo.map]
	local hasMapPos = mapPos and not (mapPos.x == 0 and mapPos.y == 0 and mapPos.z == 0)

	if mapLoaded and hasMapPos and not wormsOut and not farmState.didLobbyTp then
		tp(Vector3.new(mapPos.x, mapPos.y, mapPos.z))
		farmState.didLobbyTp = true
		autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
	end
	if wormsOut and not farmState.lastWormsSpawned and hasMapPos and not farmState.didStartTp then
	farmState.didStartTp = true
	farmState.farmRadDone = true
	-- timer trigger is round timer reaching 2:25, not a delay
end
	if wormsOut and hasMapPos then
	-- Trigger #1: round timer reaches 2:25 (145s remaining) → tp to map pos once
	if not farmState.didTpAt145 and secondsLeft <= 145 and secondsLeft > 3 then
		local mapVec = Vector3.new(mapPos.x, mapPos.y, mapPos.z)
		if safePos(mapVec) then
			tp(mapVec)
			autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
		end
		farmState.didTpAt145 = true
		farmState.farmRadT = tick()
		farmState.farmPlayerT = tick()
	end
	-- Trigger #2+: after 2:25 tp, alternate Rad ↔ Player using configured intervals
	if farmState.didTpAt145 then
		local radMode = autoSettings.farmTeleportRadius or "20"
		local plMode  = autoSettings.farmTeleportOnPlayer or "10"
		local radOn = radMode ~= "None" and radMode ~= "none" and radMode ~= ""
		local plOn  = plMode  ~= "None" and plMode  ~= "none" and plMode  ~= ""
		local radInt = radOn and (tonumber(radMode) or 20) or 0
		local plInt  = plOn  and (tonumber(plMode)  or 10) or 0
		if radInt < 0 then radInt = 0 end
		if plInt  < 0 then plInt  = 0 end
		if not farmState.nextAction then
			farmState.nextAction = "player"
			farmState.nextAt = tick() + plInt
		end
		if tick() >= (farmState.nextAt or 0) then
			if farmState.nextAction == "rad" and radOn and radInt > 0 then
				local mapVec = Vector3.new(mapPos.x, mapPos.y, mapPos.z)
				if safePos(mapVec) then
					tp(mapVec)
					autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
				end
				farmState.nextAction = "player"
				farmState.nextAt = tick() + plInt
			elseif farmState.nextAction == "player" and plOn and plInt > 0 then
				local best, bestScore = nil, -math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if isPlayerAlive(p) then
						local h = p.Character:FindFirstChild("HumanoidRootPart")
						if h and safePos(h.Position) then
							local score = (h.Position - hrp.Position).Magnitude
							if score > bestScore then bestScore = score; best = h end
						end
					end
				end
				if best then
					tp(best.Position)
					autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
				end
				farmState.nextAction = "rad"
				farmState.nextAt = tick() + radInt
			else
				farmState.nextAt = tick() + 0.5
			end
		end
	end
end
	if secondsLeft <= 3 and secondsLeft > 0 and not farmState.didHomeTp and farmHomePos and not autoSettings.hideInIntermission then
		tp(farmHomePos)
		farmState.didHomeTp = true
		autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
	end
	farmState.lastWormsSpawned = wormsOut
	farmState.lastSpawnPresent = spawnPresent
	farmState.lastMapLoaded = mapLoaded
end

local function teleportStep()
	if not autoPlay.enabled then return end
	if shouldPauseAuto() then return end
	local now = tick()
	if now < (autoPlay.freezeUntil or 0) then return end
	if now - autoPlay.lastStep < CFG.AutoPlayCooldown then return end
	local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local o = hrp.Position; local nw = nearWorm()
	local threat = nw <= autoSettings.detect
	local live = 0
	for m in pairs(tracked) do if m.Parent then live = live + 1 end end
	local any = live > 0
	if (autoPlay.lastCount > 0 and live == 0) or (autoPlay.lastCount == 0 and live > 0) then
		autoPlay.lastRoam = tick(); autoPlay.lastTarget = nil
		autoPlay.freezeUntil = tick() + CFG.AutoPlayWormSpawnGrace
	end
	autoPlay.lastCount = live
	if any and threat then
		local parts = {}
		for m in pairs(tracked) do
			if m.Parent then
				for _, p in ipairs(m:GetDescendants()) do
					if p:IsA("BasePart") then table.insert(parts, p) end
				end
			end
		end
		if #parts > 0 then
			local tgt = fleeTarget(o, parts)
			if tgt and tp(tgt.Position) then
				autoPlay.lastStep = now; autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true; return
			end
		end
		if fallbackEscape() then autoPlay.lastStep = now; return end
		return
	end
	local pMode
	if roundInfo.phase == "intermission" then
		pMode = autoSettings.tpPlayerRadInter
	else
		pMode = autoSettings.tpPlayerRadIngame
	end
	local pInt = 0
	if type(pMode) == "number" then
		pInt = pMode
	elseif type(pMode) == "string" and pMode:lower() ~= "none" then
		pInt = tonumber(pMode) or 0
	end
	if pInt <= 0 then pInt = 12 end

	if any then
		if now - autoPlay.lastRoam >= pInt then
			local t = closestP()
			if t and t.Character then
				local h = t.Character:FindFirstChild("HumanoidRootPart")
				if h then
					local pos = h.Position + Vector3.new(0,3,0)
					if safePos(pos) and tp(pos) then
						autoPlay.lastRoam = now; autoPlay.lastTarget = t
						autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
					end
				end
			end
		end
		return
	end

	if now - autoPlay.lastRoam >= pInt then
		local t = randP()
		if t and t.Character then
			local h = t.Character:FindFirstChild("HumanoidRootPart")
			if h then
				local pos = h.Position + Vector3.new(0,3,0)
				if safePos(pos) and tp(pos) then
					autoPlay.lastRoam = now; autoPlay.lastTarget = t
					autoPlay.steps = autoPlay.steps + 1; autoPlay.active = true
				end
			end
		end
	end
end

