local function applyShiftlock()
	local ch = lp.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if setState.shiftlockOn then
		hum.AutoRotate = false
		hum.CameraOffset = Vector3.new(1.75, 0.5, 0)
		pcall(function()
			UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
			UIS.MouseIconEnabled = false
		end)
		if not setRefs.shiftLockConn then
			setRefs.shiftLockConn = RunService.RenderStepped:Connect(function()
				if not setState.shiftlockOn then return end
				local c = lp.Character
				if not c then return end
				local h = c:FindFirstChildOfClass("Humanoid")
				local r = c:FindFirstChild("HumanoidRootPart")
				if not h or not r then return end
				local cam = workspace.CurrentCamera
				if not cam then return end
				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.01 then
					r.CFrame = CFrame.new(r.Position, r.Position + flat)
				end
			end)
		end
	else
		hum.AutoRotate = true
		hum.CameraOffset = Vector3.new(0, 0, 0)
		pcall(function()
			UIS.MouseBehavior = Enum.MouseBehavior.Default
			UIS.MouseIconEnabled = true
		end)
		if setRefs.shiftLockConn then
			setRefs.shiftLockConn:Disconnect()
			setRefs.shiftLockConn = nil
		end
	end
end

