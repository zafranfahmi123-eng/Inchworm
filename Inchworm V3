local function updatePath()
	local sg = setRefs.pathGui
	if not sg then return end
	sg.Enabled = setState.pathOn
	if not setState.pathOn then return end
	for _, c in ipairs(sg:GetChildren()) do c:Destroy() end
	local ch = lp.Character; local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local cam = workspace.CurrentCamera
	local thickness = setState.pathStyle == "3D" and 2 or 1
	local place = setState.pathPlace

	local function placeLine(from3, to3, color, thick)
		local sp1, on1 = cam:WorldToViewportPoint(from3)
		local sp2, on2 = cam:WorldToViewportPoint(to3)
		if not (on1 and on2) then return end
		local v1 = Vector2.new(sp1.X, sp1.Y)
		local v2 = Vector2.new(sp2.X, sp2.Y)
		local dist = (v2 - v1).Magnitude
		if dist < 2 then return end
		local mid = (v1 + v2) / 2
		local ang = math.atan2(v2.Y - v1.Y, v2.X - v1.X)
		local line = Instance.new("Frame", sg)
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Size = UDim2.fromOffset(dist, thick)
		line.Position = UDim2.fromOffset(mid.X, mid.Y)
		line.Rotation = math.deg(ang)
		line.BackgroundColor3 = color
		line.BackgroundTransparency = 0.15
		line.BorderSizePixel = 0
		line.ZIndex = 5
		local corner = Instance.new("UICorner", line)
		corner.CornerRadius = UDim.new(1, 0)
	end

	local function rayDistance(origin, dir, wormModel)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { lp.Character, setRefs.pathGui, wormModel }
		local result = workspace:Raycast(origin, dir * 80, params)
		if result then
			return (result.Position - origin).Magnitude
		end
		return 80
	end

	for m in pairs(tracked) do
		if m.Parent then
			local rt = getRoot(m)
			if rt then
				local vel = rt.AssemblyLinearVelocity
				if vel.Magnitude > 0.1 then
					local origin = rt.Position
					local flatVel = Vector3.new(vel.X, 0, vel.Z)
					if flatVel.Magnitude > 0.01 then
						local heading = flatVel.Unit
						local baseColor = Color3.fromRGB(255, 180, 40)
						if setState.pathMode == "Line" then
							local dir = flatVel.Unit
							local dist = rayDistance(origin, dir, m)
							local to3 = origin + dir * dist
							placeLine(origin, to3, baseColor, thickness)
						else
							local angles = { -40, -20, 0, 20, 40 }
							for _, deg in ipairs(angles) do
								local rad = math.rad(deg)
								local rot = CFrame.Angles(0, rad, 0)
								local dir = rot * heading
								dir = Vector3.new(dir.X, 0, dir.Z).Unit
								local dist = rayDistance(origin, dir, m)
								local to3 = origin + dir * dist
								local t = 1 - (math.abs(deg) / 50)
								local col = Color3.new(1, 0.3 + 0.4 * (1 - t), 0.4 + 0.3 * t)
								local th = math.max(1, thickness * t)
								placeLine(origin, to3, col, th)
							end
						end
					end
				end
			end
		end
	end
end

