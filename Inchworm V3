											local hh = c:FindFirstChildOfClass("Humanoid")
											if hh then
												local pt2 = math.clamp(hh.Health/math.max(hh.MaxHealth,1), 0, 1)
												local col2 = (pt2 >= 0.5) and lerp(CFG.HealthMid, CFG.HealthFull, (pt2-0.5)*2)
													or lerp(CFG.HealthLow, CFG.HealthMid, pt2*2)
												t.barFill.BackgroundColor3 = col2
											end
										end
									end
									t.nameLabel.Text = cs.nameOverride ~= "" and cs.nameOverride or t.player.DisplayName
									if cs.studs then t.distance.Text = math.floor(d).."s"
									else t.distance.Text = "" end
								end
							end
						end
					end
				end
				for inst, t in pairs(genESP) do
					if not inst.Parent then detachGen(inst)
					else
						local pos = inst:IsA("BasePart") and inst.Position
							or (getRoot(inst) and getRoot(inst).Position) or Vector3.zero
						local d = (cp - pos).Magnitude
						if d > CFG.MaxDistance then
							t.highlight.Enabled = false; t.billboard.Enabled = false
						else
							local cs = catSettings.generator
							local sh = espOptions.master and cs.enabled
							t.highlight.Enabled = sh and (cs.fillHL or cs.outlineHL)
							t.billboard.Enabled = sh
							if sh then
								scaleBB(t.billboard, d)
								local isR = false
								for _, ch in ipairs(inst:GetDescendants()) do
									if ch:IsA("ProximityPrompt") then
										local a = (ch.ActionText or ""):lower()
										if a:find(CFG.GeneratorPromptKeyword, 1, true) and ch.Enabled then isR = true; break end
									end
								end
								if isR then
									if not cs.rainbow then
										t.highlight.FillColor = CFG.GenRechargeFill; t.highlight.OutlineColor = CFG.GenRechargeOutline
									end
									t.title.TextColor3 = CFG.GenRechargeFill
									t.status.TextColor3 = CFG.GenRechargeFill
									t.status.Text = cs.genUnactiveLabel or "Recharge"
								else
									if not cs.rainbow then
										t.highlight.FillColor = cs.colour; t.highlight.OutlineColor = cs.outlineColour
									end
									t.title.TextColor3 = Color3.new(1,1,1)
									t.status.TextColor3 = cs.colour
									t.status.Text = cs.genActiveLabel or "Active"
								end
								t.title.Text = cs.nameOverride ~= "" and cs.nameOverride or "Generator"
							end
						end
					end
				end
				for inst, t in pairs(spawnerESP) do
					if not inst.Parent then detachSpawn(inst)
					else
						local rt = getRoot(inst)
						if not rt then detachSpawn(inst)
						else
							local d = (cp - rt.Position).Magnitude
							if d > CFG.MaxDistance then
								t.highlight.Enabled = false; t.billboard.Enabled = false
							else
								local cs = catSettings.spawner
								local sh = espOptions.master and cs.enabled
								t.highlight.Enabled = sh and (cs.fillHL or cs.outlineHL)
								t.billboard.Enabled = sh
								if sh then
									scaleBB(t.billboard, d)
									if cs.studs then t.distance.Text = math.floor(d).."s"
									else t.distance.Text = "" end
									t.title.Text = cs.nameOverride ~= "" and cs.nameOverride or "Inchworm Spawn"
								end
							end
						end
					end
				end
			end)
		end
		if autoPlay.enabled then
			safe("auto", autoStep)
			if autoSettings.mode == "farm" and autoSettings.hideInIntermission then
				safe("hide", hideStep)
			end
		end
		safe("status", updateStatus)
	end
end)

UIS.InputBegan:Connect(function(i, gp)
	if gp or _G.__INCHWORM_KILL then return end
	if i.KeyCode == Enum.KeyCode.RightShift then
		espOptions.master = not espOptions.master
		if espBtn then
			espBtn.Text = espOptions.master and "ESP ON" or "ESP OFF"
			espBtn.BackgroundColor3 = espOptions.master and CFG.ColOn or CFG.ColOff
		end
		applyAllVis()
	elseif i.KeyCode == Enum.KeyCode.G then
		minigame.armed = not minigame.armed
		if mgBtn then
			mgBtn.Text = minigame.armed and "MG ON" or "MINIGAME"
			mgBtn.BackgroundColor3 = minigame.armed and Color3.fromRGB(230,80,170) or CFG.ColOff
		end
	elseif i.KeyCode == Enum.KeyCode.RightControl then
		fullUnload()
	end
end)

