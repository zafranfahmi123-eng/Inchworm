local function inZone(p, z)
	local d = p - z.pos
	return math.abs(d.X) <= z.size.X * 0.5
		and math.abs(d.Y) <= z.size.Y * 0.5
		and math.abs(d.Z) <= z.size.Z * 0.5
end
local function zoneState(p)
	for _, z in ipairs(ESP_ZONES) do
		if inZone(p, z) then return z.dead end
	end
	return nil
end
local function inDeadZone()
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	for _, z in ipairs(ESP_ZONES) do
		if z.dead and inZone(hrp.Position, z) then return true end
	end
	return false
end
local function inLobby()
