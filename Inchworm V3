local function wormGrabbing(w)
	local hrp = w:FindFirstChild("HumanoidRootPart") or w.PrimaryPart
	if not hrp then return false end

	local snd = false
	local function check(inst)
		if snd or not inst:IsA("Sound") then return end
		local n = (inst.Name or ""):lower()
		if inst.Playing and (n:find("grab") or n:find("snatch") or n:find("catch")) then
			snd = true
		end
	end
	check(hrp)
	if not snd then
		for _, d in ipairs(w:GetDescendants()) do
			check(d)
			if snd then break end
		end
	end
	if not snd then return false end

	local closest, cd = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local phrp = p.Character:FindFirstChild("HumanoidRootPart")
			if phrp then
				local d = (phrp.Position - hrp.Position).Magnitude
				if d < cd and d <= 25 then cd = d; closest = p.Character end
			end
		end
	end
	return true, closest
end

