local SAVES = { slots = {}, lastActive = nil }
local function loadSaveFile()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
	local ok0, exists = pcall(isfile, CFG.SaveFile)
	if not ok0 or not exists then return end
	local ok, raw = pcall(readfile, CFG.SaveFile)
	if not ok or not raw then return end
	local ok2, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(raw)
	end)
	if ok2 and type(data) == "table" then
		SAVES.slots = data.slots or {}
		SAVES.lastActive = data.lastActive
	end
end
local function writeSaveFile()
	if type(writefile) ~= "function" then return false end
	local hs = game:GetService("HttpService")
	local ok, json = pcall(function()
		return hs:JSONEncode({ slots = SAVES.slots, lastActive = SAVES.lastActive, version = CFG.SaveVersion })
	end)
	if not ok or not json then return false end
	return (pcall(writefile, CFG.SaveFile, json))
end

