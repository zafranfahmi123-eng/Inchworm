local function spawnMapBlock(mapName)
	if not mapName or mapName == "-" or mapName == "?" then return end
	if blockRuntime.currentMap == mapName then return end
	for _, p in ipairs(blockRuntime.parts) do
		if p and p.Parent then p:Destroy() end
	end
	blockRuntime.parts = {}
	local b = autoSettings.blocks[mapName]
	if not b then blockRuntime.currentMap = nil; return end
	local part = Instance.new("Part")
	part.Name = "INCHWORM_V3_Block_" .. mapName:gsub("%s","_")
	part.Size = Vector3.new(b.sx or 23, b.sy or 1, b.sz or 31)
	part.CFrame = CFrame.new(b.x, b.y, b.z)
	part.Anchored = true
	part.CanCollide = true
	part.CanTouch = true
	part.CanQuery = false
	part.Transparency = 0.9
	part.Color = Color3.new(1, 1, 1)
	part.Material = Enum.Material.SmoothPlastic
	part.Parent = workspace
	table.insert(blockRuntime.parts, part)
	blockRuntime.currentMap = mapName
end

