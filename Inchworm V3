local function updateSpawnTimer()
	local lbl = setRefs.spawnTimerLabel
	if not lbl then return end
	if not setState.spawnTimerOn then
		lbl.Visible = false
		return
	end
	if setState.spawnTimerWhere == "Status" and statusFrame then
		if setRefs.spawnTimerParent then setRefs.spawnTimerParent.Enabled = true end
		if lbl.Parent ~= setRefs.spawnTimerParent then
			lbl.Parent = setRefs.spawnTimerParent
		end
		local sf = statusFrame
		lbl.Position = UDim2.new(sf.Position.X.Scale, sf.Position.X.Offset + CFG.StatusPanelW + 5,
			sf.Position.Y.Scale, sf.Position.Y.Offset + 2)
		lbl.Size = UDim2.fromOffset(90, 20)
		lbl.ZIndex = 200
	else
		if setRefs.spawnTimerParent then setRefs.spawnTimerParent.Enabled = true end
		if lbl.Parent ~= setRefs.spawnTimerParent then
			lbl.Parent = setRefs.spawnTimerParent
		end
		lbl.Position = UDim2.new(0.5, -45, 0, 8)
		lbl.Size = UDim2.fromOffset(90, 20)
		lbl.ZIndex = 200
	end
	local wf = workspace:FindFirstChild(CFG.WormFolderName)
	local spawnPresent, wormPresent = false, false
	if wf then
		for _, c in ipairs(wf:GetChildren()) do
			local n = (c.Name or ""):lower()
			if n:find("wormspawn", 1, true) then spawnPresent = true
			else wormPresent = true end
		end
	end
	local now = tick()
	if wormPresent then
		if not setState.roundStartedDone then
			setState.roundStartedAt = now
			setState.roundStartedDone = true
		end
		if now - setState.roundStartedAt < 3 then
			lbl.Text = "Round Started!"
			lbl.TextColor3 = Color3.fromRGB(0, 255, 120)
			lbl.Visible = true
			return
		end
		lbl.Visible = false
		return
	end
	if not wormPresent then
		setState.roundStartedDone = false
		setState.roundStartedAt = 0
	end
	if spawnPresent then
		if setState.wormSpawnT == 0 then setState.wormSpawnT = now end
		local elapsed = now - setState.wormSpawnT
		local remaining = 3 - elapsed
		local display = math.max(0, math.ceil(remaining))
		lbl.Text = string.format("Worm: %ds", display)
		if remaining <= 1 then
			lbl.TextColor3 = Color3.fromRGB(255, 60, 60)
		else
			lbl.TextColor3 = Color3.fromRGB(255, 200, 80)
		end
		lbl.Visible = true
	else
		setState.wormSpawnT = 0
		lbl.Visible = false
	end
end

