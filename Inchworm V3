local function isPM(m)
	if Players:GetPlayerFromCharacter(m) then return true end
	for _, p in ipairs(Players:GetPlayers()) do if p.Character == m then return true end end
	return false
end
local ancCache = {}
local function blocked(o)
	local e = ancCache[o]; local n = tick()
	if e and (n-e.t) < 1 then return e.v end
	local c = o
	while c and c ~= workspace do
		if c.ClassName == "Backpack" or c.ClassName == "Tool" then ancCache[o] = {v=true,t=n}; return true end
		if Players:GetPlayerFromCharacter(c) then ancCache[o] = {v=true,t=n}; return true end
		c = c.Parent
	end
	ancCache[o] = { v = false, t = n }; return false
end
local function nameHas(nm, list)
	local n = (nm or ""):lower()
	for _, k in ipairs(list) do if n:find(k,1,true) then return true end end
	return false
end
local function isWorm(m)
	if not m:IsA("Model") or isPM(m) or blocked(m) then return false end
	local f = m.Parent
	if not f or not f:IsA("Folder") or f.Name ~= CFG.WormFolderName then return false end
	if not m.Name:lower():find("worm",1,true) then return false end
	if nameHas(m.Name, CFG.WormSpawnNames) then return false end
	return true
end
local function isSpawn(m)
	if not m:IsA("Model") or isPM(m) or blocked(m) then return false end
	local f = m.Parent
	if not f or not f:IsA("Folder") or f.Name ~= CFG.WormFolderName then return false end
	return nameHas(m.Name, CFG.WormSpawnNames)
end
local function isGen(inst)
	if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
	if isPM(inst) or blocked(inst) then return false end
	local n = (inst.Name or ""):lower()
	if not n:find("gen",1,true) then
		local hasRecharge = false
		if inst:IsA("Model") then
			for _, c in ipairs(inst:GetDescendants()) do
				if c:IsA("ProximityPrompt") then
					local a = (c.ActionText or ""):lower()
					if a:find(CFG.GeneratorPromptKeyword,1,true) and c.Enabled and c.HoldDuration > 0 then
						hasRecharge = true; break
					end
				end
			end
		end
		if not hasRecharge then return false end
	end
	return true
end
local function readHP(c, h)
	if h and h.MaxHealth and h.MaxHealth > 0 then return h.Health, h.MaxHealth end
	for _, x in ipairs({c, h}) do
		if x then
			local a = x:GetAttribute("Health") or x:GetAttribute("HP")
			local m = x:GetAttribute("MaxHealth") or x:GetAttribute("MaxHP")
			if typeof(a) == "number" then return a, (typeof(m)=="number" and m) or 100 end
		end
	end
	return nil, nil
end
