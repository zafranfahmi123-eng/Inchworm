			setState.roundStartT = tick()
			setState.roundWasDead = false
			setState.roundDeathT = 0
			setState.roundPoints = 0
		end
		-- Death during round
		if phase == "round" and not setState.roundWasDead then
			local ch = lp.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if not ch or not hum or hum.Health <= 0 then
				setState.roundWasDead = true
				setState.roundDeathT = tick()
			end
		end
		-- Round end
		if setState.roundPhaseMem == "round" and phase == "intermission" then
			local endT = tick()
			local startT = setState.roundStartT > 0 and setState.roundStartT or endT
			local liveSec
			if setState.roundWasDead and setState.roundDeathT > 0 then
				liveSec = setState.roundDeathT - startT
			else
				liveSec = endT - startT
			end
			local win = not setState.roundWasDead
			if setState.antiAfkOn then
				addHistoryEntry(win, liveSec)
			end
		end
		setState.roundPhaseMem = phase
	end
end)

